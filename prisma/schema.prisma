// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model SystemSetting {
  id                        String   @id @default("global")
  cancellationCutoffMinutes Int      @default(90)
  maxHoursPerDay            Int      @default(2)
  maxDaysInAdvance          Int      @default(3)
  courtOpenTime             Int      @default(6)
  courtCloseTime            Int      @default(23)
  calendarDaysToShow        Int      @default(3)
  calendarSkipDays          Int      @default(1)
  enableCsvImport           Boolean  @default(true)
  enableWelcomeEmails       Boolean  @default(true)
  enableMemberCourtBooking  Boolean  @default(true)
  enableQrCheckIn           Boolean  @default(false)
  requireGpsCheckIn         Boolean  @default(false)
  clubLatitude              Float?
  clubLongitude             Float?
  primaryColor              String   @default("#4f46e5")
  secondaryColor            String   @default("#10b981")
  fontFamily                String   @default("Inter")
  heroImageUrl              String?
  promoImageUrl             String?
  promoLinkUrl              String?
  externalWebsiteUrl        String?
  logoUrl                   String?
  simpleLandingPage         Boolean  @default(false)
  activeSeason              String   @default("2026")
  genderOptions             String[] @default(["Male", "Female", "Prefer not to say"])
  
  heroTitle                 String?  @default("Elevate Your Game at")
  heroSubtitle              String?  @default("Experience premier tennis facilities, professional coaching, and a vibrant community of players of all levels.")
  feature1Title             String?  @default("Pristine Courts")
  feature1Desc              String?  @default("Play on our perfectly maintained surfaces. Easy online booking ensures your court is ready when you are.")
  feature2Title             String?  @default("Expert Coaching")
  feature2Desc              String?  @default("Elevate your skills with our certified professionals offering group clinics and private lessons.")
  feature3Title             String?  @default("Vibrant Community")
  feature3Desc              String?  @default("Join tournaments, ladders, and social events. Find playing partners easily through our member portal.")

  updatedAt                 DateTime @updatedAt
}

model User {
  id           String       @id @default(cuid())
  firstName    String
  lastName     String
  email        String       @unique
  passwordHash String
  streetAddress String?
  city         String?
  postalCode   String?
  phoneNumber  String?
  alternatePhoneNumber String?
  notes        String?
  gender       String?
  dateOfBirth  DateTime?
  wantsFreeLessons Boolean @default(false)
  householdId  String?
  tagNumber    String?
  memberNumber String?      @unique
  role             String       @default("MEMBER")
  adminPermissions String[]     @default([])
  adminNotifications String[]   @default([])
  managementRole   String?
  editToken        String?
  resetToken       String?      @unique
  resetTokenExpiry DateTime?
  welcomeEmailSent Boolean      @default(true)
  lastReadReleaseHash String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  memberships           Membership[]
  organizedBookings     Booking[]    @relation("BookingOrganizer")
  coOrganizedBookings   Booking[]    @relation("BookingCoOrganizer")
  participatingBookings Booking[]    @relation("BookingParticipants")
  waitlistedBookings    Booking[]    @relation("BookingWaitlist")
  eventRegistrations    EventRegistration[]
}

model Membership {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  membershipType    String
  season            String    @default("2026")
  status            String
  amountPaid        Float?
  paymentNotes      String?
  paymentRecordedAt DateTime?
  
  appliedCouponId   String?
  appliedCoupon     CouponCode? @relation("MembershipCoupons", fields: [appliedCouponId], references: [id])
  discountAmount    Float?

  createdAt         DateTime  @default(now())
}

model MembershipPlan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  cost        Float
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String   @unique
  phoneNumber String?
  gender      String?
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
}

model ArchivedMembership {
  id                   String    @id @default(cuid())
  originalUserId       String
  originalMembershipId String
  firstName            String
  lastName             String
  email                String
  phoneNumber          String?
  gender               String?
  dateOfBirth          DateTime?
  wantsFreeLessons     Boolean   @default(false)
  membershipType       String
  status               String
  amountPaid           Float?
  paymentNotes         String?
  paymentRecordedAt    DateTime?
  originalCreatedAt    DateTime
  archivedAt           DateTime  @default(now())
}

model Court {
  id        String    @id @default(cuid())
  name      String    @unique
  openTime  Int?
  closeTime Int?
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Booking {
  id          String   @id @default(cuid())
  courtId     String
  court       Court    @relation(fields: [courtId], references: [id])
  startTime   DateTime
  endTime     DateTime
  type        String   @default("MEMBER") // 'MEMBER', 'LESSON', 'LEAGUE', 'MAINTENANCE'
  status      String   @default("ACTIVE") // 'ACTIVE', 'CANCELLED'
  title       String?
  description String?
  notes       String?
  checkedInAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  organizerId String?
  organizer   User?    @relation("BookingOrganizer", fields: [organizerId], references: [id])
  
  coOrganizerId String?
  coOrganizer   User?  @relation("BookingCoOrganizer", fields: [coOrganizerId], references: [id])
  
  internalNotes String?
  
  participants User[]  @relation("BookingParticipants")
  waitlistedUsers User[] @relation("BookingWaitlist")
  
  minParticipants Int?
  maxParticipants Int?
  cost            Float?
  
  recurringGroupId String?
}

model EmailTemplate {
  id        String   @id // e.g., 'WELCOME_EMAIL', 'NEW_REGISTRATION'
  subject   String
  htmlBody  String
  updatedAt DateTime @updatedAt
}

model BookingType {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#3b82f6") // Hex color for the calendar
  isBuiltIn Boolean  @default(false)     // True for 'MEMBER' so it can't be deleted
  
  allowMemberRegistration Boolean @default(false)
  minParticipants Int?
  maxParticipants Int?
  defaultCost     Float?
  
  createdAt DateTime @default(now())
}

model ClubEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  isAllDay    Boolean  @default(false)
  colorHex    String   @default("#8b5cf6")
  season      String   @default("2026")
  cost        Float?
  maxParticipants Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  registrations EventRegistration[]
  validCoupons  CouponCode[] @relation("EventCoupons")
}

model EventRegistration {
  id           String    @id @default(cuid())
  eventId      String
  event        ClubEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String    @default("REGISTERED") // 'REGISTERED', 'WAITLISTED', 'CANCELLED'
  hasPaid      Boolean   @default(false)
  registeredAt DateTime  @default(now())
  
  appliedCouponId String?
  appliedCoupon   CouponCode? @relation("EventRegistrationCoupons", fields: [appliedCouponId], references: [id])
  discountAmount  Float?

  @@unique([eventId, userId])
}

model CouponCode {
  id                  String   @id @default(cuid())
  code                String   @unique
  discountType        String   // "PERCENT" or "FIXED"
  discountAmount      Float
  description         String?
  maxUses             Int?     // null means unlimited
  currentUses         Int      @default(0)
  expiryDate          DateTime?
  validForMemberships Boolean  @default(false)
  
  validEvents         ClubEvent[] @relation("EventCoupons")
  
  membershipsUsed     Membership[] @relation("MembershipCoupons")
  eventRegistrationsUsed EventRegistration[] @relation("EventRegistrationCoupons")
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CustomPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  contentHtml String
  isPublished Boolean  @default(true)
  isPublic    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(cuid())
  name      String?
  email     String?
  subject   String
  message   String
  userAgent String?
  appVersion String?
  status    String   @default("NEW") // 'NEW', 'REVIEWED', 'ARCHIVED'
  createdAt DateTime @default(now())
}
