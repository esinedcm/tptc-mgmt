// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SystemSetting {
  id                        String   @id @default("global")
  cancellationCutoffMinutes Int      @default(90)
  maxHoursPerDay            Int      @default(2)
  maxDaysInAdvance          Int      @default(3)
  courtOpenTime             Int      @default(6)
  courtCloseTime            Int      @default(23)
  calendarDaysToShow        Int      @default(3)
  calendarSkipDays          Int      @default(1)
  enableCsvImport           Boolean  @default(true)
  enableWelcomeEmails       Boolean  @default(true)
  primaryColor              String   @default("#4f46e5")
  activeSeason              String   @default("2026")
  genderOptions             String[] @default(["Male", "Female", "Prefer not to say"])
  updatedAt                 DateTime @updatedAt
}

model User {
  id           String       @id @default(cuid())
  firstName    String
  lastName     String
  email        String       @unique
  passwordHash String
  streetAddress String?
  city         String?
  postalCode   String?
  phoneNumber  String?
  alternatePhoneNumber String?
  notes        String?
  gender       String?
  dateOfBirth  DateTime?
  wantsFreeLessons Boolean @default(false)
  householdId  String?
  tagNumber    String?
  memberNumber String?      @unique
  role             String       @default("MEMBER")
  editToken        String?
  resetToken       String?      @unique
  resetTokenExpiry DateTime?
  welcomeEmailSent Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  memberships           Membership[]
  organizedBookings     Booking[]    @relation("BookingOrganizer")
  participatingBookings Booking[]    @relation("BookingParticipants")
}

model Membership {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  membershipType    String
  season            String    @default("2026")
  status            String
  amountPaid        Float?
  paymentNotes      String?
  paymentRecordedAt DateTime?
  createdAt         DateTime  @default(now())
}

model MembershipPlan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  cost        Float
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String   @unique
  phoneNumber String?
  gender      String?
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
}

model ArchivedMembership {
  id                   String    @id @default(cuid())
  originalUserId       String
  originalMembershipId String
  firstName            String
  lastName             String
  email                String
  phoneNumber          String?
  gender               String?
  dateOfBirth          DateTime?
  wantsFreeLessons     Boolean   @default(false)
  membershipType       String
  status               String
  amountPaid           Float?
  paymentNotes         String?
  paymentRecordedAt    DateTime?
  originalCreatedAt    DateTime
  archivedAt           DateTime  @default(now())
}

model Court {
  id        String    @id @default(cuid())
  name      String    @unique
  openTime  Int?
  closeTime Int?
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Booking {
  id          String   @id @default(cuid())
  courtId     String
  court       Court    @relation(fields: [courtId], references: [id])
  startTime   DateTime
  endTime     DateTime
  type        String   @default("MEMBER") // 'MEMBER', 'LESSON', 'LEAGUE', 'MAINTENANCE'
  status      String   @default("ACTIVE") // 'ACTIVE', 'CANCELLED'
  title       String?
  description String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  organizerId String?
  organizer   User?    @relation("BookingOrganizer", fields: [organizerId], references: [id])
  
  participants User[]  @relation("BookingParticipants")
  
  recurringGroupId String?
}

model EmailTemplate {
  id        String   @id // e.g., 'WELCOME_EMAIL', 'NEW_REGISTRATION'
  subject   String
  htmlBody  String
  updatedAt DateTime @updatedAt
}

model BookingType {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#3b82f6") // Hex color for the calendar
  isBuiltIn Boolean  @default(false)     // True for 'MEMBER' so it can't be deleted
  createdAt DateTime @default(now())
}

model ClubEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  isAllDay    Boolean  @default(false)
  colorHex    String   @default("#8b5cf6")
  season      String   @default("2026")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
